<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Modern Multi-Option Login</title>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #311042 100%);
      color: #f8fafc;
      padding: 20px;
    }

    .container {
      width: 100%;
      max-width: 440px;
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 24px;
      padding: 32px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    }

    .header {
      text-align: center;
      margin-bottom: 24px;
    }

    .header h2 {
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .header p {
      font-size: 14px;
      color: #94a3b8;
    }

    .tabs {
      display: flex;
      background: rgba(0, 0, 0, 0.2);
      padding: 4px;
      border-radius: 12px;
      margin-bottom: 24px;
    }

    .tab-btn {
      flex: 1;
      padding: 10px;
      border: none;
      background: transparent;
      color: #94a3b8;
      font-weight: 600;
      font-size: 13px;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    .tab-btn.active {
      background: #6366f1;
      color: white;
      box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
    }

    .form-group {
      margin-bottom: 18px;
    }

    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: 500;
      margin-bottom: 6px;
      color: #cbd5e1;
    }

    .input-box {
      position: relative;
      display: flex;
      align-items: center;
    }

    .input-box i {
      position: absolute;
      left: 14px;
      color: #64748b;
      width: 18px;
      height: 18px;
    }

    .input-box input {
      width: 100%;
      padding: 12px 14px 12px 42px;
      background: rgba(0, 0, 0, 0.25);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 10px;
      color: white;
      font-size: 14px;
      outline: none;
      transition: border 0.3s;
    }

    .input-box input:focus {
      border-color: #6366f1;
    }

    .btn {
      width: 100%;
      padding: 12px;
      background: #6366f1;
      border: none;
      border-radius: 10px;
      color: white;
      font-weight: 600;
      font-size: 15px;
      cursor: pointer;
      transition: background 0.3s;
      margin-top: 10px;
    }

    .btn:hover {
      background: #4f46e5;
    }

    .divider {
      display: flex;
      align-items: center;
      margin: 24px 0;
      color: #64748b;
      font-size: 12px;
    }

    .divider::before, .divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: rgba(255, 255, 255, 0.1);
    }

    .divider span {
      padding: 0 10px;
    }

    .social-btn {
      width: 100%;
      padding: 10px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 10px;
      color: white;
      font-size: 14px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: background 0.3s;
    }

    .social-btn:hover {
      background: rgba(255, 255, 255, 0.1);
    }

    .qr-box {
      text-align: center;
      padding: 20px 0;
    }

    .qr-box img {
      width: 160px;
      height: 160px;
      border-radius: 12px;
      border: 4px solid white;
    }

    .form-content {
      display: none;
    }

    .form-content.active {
      display: block;
    }
  </style>
</head>
<body>

  <div class="container">
    <div class="header">
      <h2>Welcome Back</h2>
      <p>Apna login option chunein</p>
    </div>

    <!-- Navigation Tabs -->
    <div class="tabs">
      <button class="tab-btn active" onclick="switchTab('phone')">
        <i data-lucide="smartphone"></i> Phone OTP
      </button>
      <button class="tab-btn" onclick="switchTab('password')">
        <i data-lucide="user"></i> User / Pass
      </button>
      <button class="tab-btn" onclick="switchTab('qr')">
        <i data-lucide="qr-code"></i> QR Code
      </button>
    </div>

    <!-- 1. Phone OTP Form -->
    <div id="phone-form" class="form-content active">
      <form onsubmit="event.preventDefault();">
        <div class="form-group">
          <label>Mobile Number</label>
          <div class="input-box">
            <i data-lucide="phone"></i>
            <input type="tel" placeholder="+91 98765 43210" required>
          </div>
        </div>
        <button type="submit" class="btn">Get OTP</button>
      </form>
    </div>

    <!-- 2. Username / Password Form -->
    <div id="password-form" class="form-content">
      <form onsubmit="event.preventDefault();">
        <div class="form-group">
          <label>Username / ID</label>
          <div class="input-box">
            <i data-lucide="user"></i>
            <input type="text" placeholder="Username ya User ID" required>
          </div>
        </div>
        <div class="form-group">
          <label>Password</label>
          <div class="input-box">
            <i data-lucide="lock"></i>
            <input type="password" placeholder="••••••••" required>
          </div>
        </div>
        <button type="submit" class="btn">Login</button>
      </form>
    </div>

    <!-- 3. QR Code Form -->
    <div id="qr-form" class="form-content">
      <div class="qr-box">
        <img src="https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=LoginDemo" alt="QR Code">
        <p style="margin-top: 12px; font-size: 13px; color: #94a3b8;">Mobile app se scan karke login karein</p>
      </div>
    </div>

    <div class="divider">
      <span>YA PHIR</span>
    </div>

    <!-- Social Login -->
    <button class="social-btn">
      <i data-lucide="chrome"></i> Continue with Google
    </button>
  </div>

  <script>
    // Initialize Lucide icons
    lucide.createIcons();

    // Tab Switch Logic
    function switchTab(tabName) {
      document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
      document.querySelectorAll('.form-content').forEach(form => form.classList.remove('active'));

      if (tabName === 'phone') {
        event.currentTarget.classList.add('active');
        document.getElementById('phone-form').classList.add('active');
      } else if (tabName === 'password') {
        event.currentTarget.classList.add('active');
        document.getElementById('password-form').classList.add('active');
      } else if (tabName === 'qr') {
        event.currentTarget.classList.add('active');
        document.getElementById('qr-form').classList.add('active');
      }
    }
  </script>
</body>
</html>
